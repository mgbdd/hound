# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ── Agent: which provider/model the LangGraph agent and RAG use ────────────────
AI_PROVIDER=yandex            # yandex | gigachat | mistral | gemini
AI_MODEL=yandexgpt

# Optional: route every provider through OpenRouter (see agents/*.py, RAG.py)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Explicit switch. Unset -> on when OPENROUTER_API_KEY is set. Force native SDK: USE_OPENROUTER=false
USE_OPENROUTER=

# ── Telegram bot ──────────────────────────────────────────────────────────────
TG_BOT_TOKEN=
# Service URLs default to the docker-compose network names; override for local runs.
PROCESSING_SERVER_URL=http://processor_server:3030/api
RAG_SERVER_URL=http://agent:8001
RAG_GRAPH_ID=hound-search

# ── Langfuse (prompt registry + tracing) ─────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Provider API keys (fill only the one(s) you use) ─────────────────────────
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

YC_FOLDER_ID=
YANDEX_API_KEY=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

GEMINI_API_KEY=
GEMINI_BASE_URL=

# ── Qdrant (vector store, shared by processor_server and RAG) ────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
HF_TOKEN=
TAVILY_API_KEY=
CHECKPOINT_DB_PATH=agent/db/agent_checkpoints.db

# ── Eval only (see requirements.eval.txt) ───────────────────────────────────
RAGAS_JUDGE_MODEL=google/gemini-2.0-flash-001
RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small
